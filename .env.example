APP_ENV=development

LOG_LEVEL=INFO

LLM_PROVIDER=groq
LLM_FALLBACK_PROVIDER=openai

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

LLM_MAX_ATTEMPTS=3
LLM_RETRY_INITIAL_DELAY=0.5
LLM_RETRY_BACKOFF_MULTIPLIER=2.0

CACHE_ENABLED=true
RESEARCH_CACHE_TTL_SECONDS=3600